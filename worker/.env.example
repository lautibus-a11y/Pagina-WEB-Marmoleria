# ═══════════════════════════════════════════════════════════════
# Variables de entorno — Cloudflare Worker (Chatbot IA)
# 
# INSTRUCCIONES:
#   1. Copiar este archivo a .env (no commitear .env)
#   2. Reemplazar los valores placeholder con los reales
#   3. La OPENROUTER_API_KEY se configura como secret de Cloudflare:
#      npx wrangler secret put OPENROUTER_API_KEY
# ═══════════════════════════════════════════════════════════════

# API Key de OpenRouter (obtener en https://openrouter.ai/keys)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Modelo de IA de OpenRouter
# Opciones recomendadas (económicas):
#   google/gemini-2.5-flash
#   anthropic/claude-3.5-haiku
#   meta-llama/llama-3.1-8b-instruct
AI_MODEL=YOUR_OPENROUTER_MODEL

# Dominio permitido para CORS
ALLOWED_ORIGIN=https://marmoleria-benjamin.com
